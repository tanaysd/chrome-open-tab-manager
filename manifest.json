{
  "manifest_version": 3,
  "name": "Open Tab Transfer",
  "version": "0.1.0",
  "description": "Export open Chrome tabs to a local encrypted file and import them on another Chrome instance.",
  "permissions": [
    "tabs",
    "downloads",
    "storage"
  ],
  "action": {
    "default_title": "Open Tab Transfer",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
